# Railway API health endpoint (public)
VITE_API_HEALTH_URL=https://api-production-8ac1f.up.railway.app/api/v1/health
VITE_API_OPS_URL=https://api-production-8ac1f.up.railway.app/api/v1/ops/snapshot

# Optional: main frontend URL to ping
VITE_FRONTEND_URL=https://huphup-frontend.vercel.app

# Auto-check interval in seconds
VITE_POLL_SECONDS=10

# MONITOR_SECRET is NOT a VITE_ var. Enter it in the monitor UI.
# Set the same value on Railway as MONITOR_SECRET.
